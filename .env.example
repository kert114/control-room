# PostgreSQL connection string used by the app, migrations, and the seed script.
DATABASE_URL=postgresql://control_room:control_room@127.0.0.1:5432/control_room

# Auth.js signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-32-character-minimum-secret

# Synthetic credential sign-in and the demo-mode banner. Never true in production.
DEMO_MODE=true

# Real SSO. All three are required before the Entra provider is offered.
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
